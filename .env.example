# Supabase (site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique (QR / liens absolus)
NEXT_PUBLIC_SITE_URL=https://www.festivalyuna.com

# CRM (projet Supabase séparé) — dump inscriptions /staff/crm
YUNA_CRM_SUPABASE_URL=
YUNA_CRM_SERVICE_ROLE_KEY=
# Pull API + webhook (https uniquement). OBLIGATOIRE pour /staff/crm — distinct du scan.
YUNA_CRM_API_KEY=
YUNA_CRM_WEBHOOK_URL=
# Alias acceptés : CRM_API_KEY, CRM_WEBHOOK_URL

# Staff scan porte (/staff/scan) — NE DONNE PLUS accès au dump CRM
YUNA_STAFF_SECRET=
# YUNA_STAFF_SECRETS=label:secret,autre:secret

# WhatsApp contact (optionnel — bouton sticky + footer)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Confirmation auto SMS / WhatsApp (async after inscription) ---
# Twilio (recommandé : WhatsApp + SMS avec un seul compte)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_CONTENT_SID=   # template Content API (prod Meta)
# TWILIO_SMS_FROM=+1...
# Meta Cloud API (alternative WhatsApp)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=yuna_pass_confirmation
# WHATSAPP_TEMPLATE_LANG=fr

# --- Apple Wallet (.pkpass) ---
# APPLE_PASS_TYPE_ID=pass.com.yunafestival.entry
# APPLE_TEAM_ID=
# APPLE_PASS_ORG_NAME=YUNA Festival
# APPLE_PASS_WWDR_PEM=          # PEM ou base64
# APPLE_PASS_SIGNER_CERT_PEM=
# APPLE_PASS_SIGNER_KEY_PEM=
# APPLE_PASS_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet (Save to Wallet JWT) ---
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_ID=       # id classe EventTicket (avec ou sans issuer prefix)
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=    # PEM PKCS8 ou base64

# Paiements FedaPay (optionnel — boutique / dons)
# NEXT_PUBLIC_FEDAPAY_BOUTIQUE_URL=
# NEXT_PUBLIC_FEDAPAY_DONATE_URL=

# Teaser YouTube (optionnel)
# NEXT_PUBLIC_YUNA_TEASER_ID=

# Rate-limit distribué (Upstash Redis) — requis en multi-instances avant le jour J.
# Sans ces variables, repli mémoire (OK en local, insuffisant en prod multi-λ).
# Intégration Vercel Upstash injecte KV_REST_API_* (préféré en prod).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
