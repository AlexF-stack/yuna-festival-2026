# Supabase (site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CRM (projet Supabase séparé)
YUNA_CRM_SUPABASE_URL=
YUNA_CRM_SERVICE_ROLE_KEY=

# Staff scan
YUNA_STAFF_SECRET=
# YUNA_STAFF_SECRETS=label:secret,autre:secret

# WhatsApp (optionnel — bouton flottant retiré ; contact footer)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Rate-limit distribué (Upstash Redis) — requis en multi-instances avant le jour J.
# Sans ces variables, repli mémoire (OK en local, insuffisant en prod multi-λ).
# Intégration Vercel Upstash injecte KV_REST_API_* (préféré en prod).
# Les noms UPSTASH_REDIS_REST_* restent supportés en local / config manuelle.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
