# Supabase (site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique (QR / liens absolus)
NEXT_PUBLIC_SITE_URL=https://yunafestival.com

# CRM (projet Supabase séparé)
YUNA_CRM_SUPABASE_URL=
YUNA_CRM_SERVICE_ROLE_KEY=
# Pull API + webhook (https uniquement)
YUNA_CRM_API_KEY=
YUNA_CRM_WEBHOOK_URL=
# Alias acceptés : CRM_API_KEY, CRM_WEBHOOK_URL

# Staff scan
YUNA_STAFF_SECRET=
# YUNA_STAFF_SECRETS=label:secret,autre:secret

# WhatsApp (optionnel — bouton sticky + footer)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Paiements FedaPay (optionnel — boutique / dons)
# NEXT_PUBLIC_FEDAPAY_BOUTIQUE_URL=
# NEXT_PUBLIC_FEDAPAY_DONATE_URL=

# Teaser YouTube (optionnel)
# NEXT_PUBLIC_YUNA_TEASER_ID=

# Rate-limit distribué (Upstash Redis) — requis en multi-instances avant le jour J.
# Sans ces variables, repli mémoire (OK en local, insuffisant en prod multi-λ).
# Intégration Vercel Upstash injecte KV_REST_API_* (préféré en prod).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
